NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Explicit local-only fallback. Ignored by production builds even if set.
NEXT_PUBLIC_LOCAL_MOCK_DATA=false

# Explicit Vercel Preview demo. Effective only when VERCEL_ENV=preview.
NEXT_PUBLIC_DEMO_MODE=false
